# Copy this file to backend/.env and fill in real values.
#
# Development (DJANGO_SETTINGS_MODULE=config.settings.local)
SECRET_KEY=replace-me-with-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://writing:writing@localhost:5432/writing_local

# ---------------------------------------------------------------------------
# Production
#
# This half belongs in /opt/app/.env on the VPS, next to
# docker-compose.prod.yml, not in backend/. Compose reads it twice: for the
# ${...} substitutions in the compose file itself, and as the backend
# container's env_file.
#
# Never reuse the development SECRET_KEY. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# SECRET_KEY=<50 random characters, generated fresh for the server>
# DEBUG=False
#
# Three hosts, and each is needed for a different reason: the two public names
# because Django validates the Host header against this list, and `backend`
# because that is the Host the SSR container sends when it calls the API across
# the compose network. Leave it out and every server render gets a 400.
# ALLOWED_HOSTS=alexandrapintea.eu,www.alexandrapintea.eu,backend
#
# With the scheme, unlike ALLOWED_HOSTS. Wrong here means the admin login form
# fails CSRF with nothing on screen to say why.
# CSRF_TRUSTED_ORIGINS=https://alexandrapintea.eu,https://www.alexandrapintea.eu
#
# DEFAULT_SITE_DOMAIN=alexandrapintea.eu
#
# Raise to 31536000 after a week of clean HTTPS. See production.py on why not
# sooner — HSTS is cached by browsers and cannot be taken back quickly.
# SECURE_HSTS_SECONDS=3600
#
# Postgres. DATABASE_URL is composed from these by docker-compose.prod.yml, so
# the password is written once.
# POSTGRES_DB=writing
# POSTGRES_USER=writing
# POSTGRES_PASSWORD=<strong password, not the development one>
