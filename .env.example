# Copy this file to backend/.env and fill in real values.
#
# Development (DJANGO_SETTINGS_MODULE=config.settings.local)
SECRET_KEY=replace-me-with-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://writing:writing@localhost:5432/writing_local

# ---------------------------------------------------------------------------
# Production (DJANGO_SETTINGS_MODULE=config.settings.production)
#
# On the VPS this lives at /opt/app/.env and is read by docker compose, not by
# this file. Never reuse the development SECRET_KEY: generate a fresh one with
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# SECRET_KEY=<50 random characters, generated fresh for the server>
# DEBUG=False
# ALLOWED_HOSTS=alexandrapintea.eu,www.alexandrapintea.eu
# CSRF_TRUSTED_ORIGINS=https://alexandrapintea.eu,https://www.alexandrapintea.eu
# DATABASE_URL=postgres://writing:<strong password>@db:5432/writing
# DEFAULT_SITE_DOMAIN=alexandrapintea.eu
#
# Raise to 31536000 after a week of clean HTTPS. See production.py on why not
# sooner — HSTS is cached by browsers and cannot be taken back quickly.
# SECURE_HSTS_SECONDS=3600
#
# Where collectstatic writes and uploads live inside the container. Both are
# bind-mounted to the host so nginx can serve them without touching Django.
# STATIC_ROOT=/app/staticfiles
# MEDIA_ROOT=/app/media